# ============================================================
# SWEATBOX FITNESS - ORACLE CLOUD PRODUCTION ENVIRONMENT
# ============================================================

# Domain / Public URL
# Set this to your domain (e.g., https://sweatbox.yourdomain.com) or your OCI Public IP (e.g. http://129.151.x.x)
CORS_ORIGIN=http://your-oracle-cloud-public-ip

# Database (PostgreSQL)
DB_USER=sweatbox_admin
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE
DB_NAME=sweatbox_db

# Cryptographic Tokens (Generate random 32+ char hex strings)
# Tip: Run `openssl rand -hex 32` in your server terminal
JWT_ACCESS_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32_ACCESS_TOKEN
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32_REFRESH_TOKEN
JWT_REFRESH_EXPIRY=7d
QR_HMAC_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32_QR_HMAC_KEY

# Email Configuration (SMTP)
# OPTION A: Built-in local Mailpit (Test Mode - intercepts emails at http://server-ip:8025)
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=SWEATBOX Fitness <no-reply@sweatboxfitness.et>

# OPTION B: Real Gmail Account (Production Mode - sends real emails to user inboxes)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgymemail@gmail.com
SMTP_PASS=your_16_character_google_app_password
SMTP_FROM=SWEATBOX Fitness <yourgymemail@gmail.com>

# Payment Gateway (Chapa Ethiopia)
CHAPA_SECRET_KEY=CHASECK_TEST-your-secret-key-here
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-your-public-key-here
CHAPA_WEBHOOK_SECRET=your-chapa-webhook-secret-here
CHAPA_BASE_URL=https://api.chapa.co/v1

# AI Fitness Engine (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
