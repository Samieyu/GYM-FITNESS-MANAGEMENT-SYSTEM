{
  "name": "gym-management-backend",
  "version": "1.0.0",
  "description": "Backend REST API for Gym and Fitness Management System",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "node ./node_modules/typescript/bin/tsc && node -e \"const fs = require('fs'); const path = require('path'); const src = 'src/db/migrations'; const dst = 'dist/db/migrations'; if (fs.existsSync(src)) { fs.mkdirSync(dst, { recursive: true }); fs.readdirSync(src).forEach(f => fs.copyFileSync(path.join(src, f), path.join(dst, f))); }\"",
    "start": "node dist/server.js",
    "test": "node ./node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node ./node_modules/jest/bin/jest.js --coverage --runInBand",
    "migrate": "node dist/db/migrator.js",
    "seed": "node dist/db/seed.js"
  },
  "keywords": ["gym", "fitness", "management", "express", "postgresql"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0",
    "tsx": "^4.15.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.5.2"
  }
}
