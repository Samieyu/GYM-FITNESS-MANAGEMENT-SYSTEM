# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=gym_user
DB_PASSWORD=gym_password
DB_NAME=gym_db
DB_SSL=false

# Authentication & Security
JWT_ACCESS_SECRET=super_secret_access_jwt_key_gym_2026_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_gym_2026_change_in_production
JWT_REFRESH_EXPIRY=7d
QR_HMAC_SECRET=super_secret_qr_hmac_key_gym_2026_change_in_production

# Mailpit SMTP Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Gym & Fitness System <no-reply@gymfitness.local>"

# Chapa Payment Gateway (Test Mode)
CHAPA_SECRET_KEY=CHASECK_TEST-sample_secret_key
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-sample_public_key
CHAPA_WEBHOOK_SECRET=sample_webhook_secret_key
CHAPA_BASE_URL=https://api.chapa.co/v1

# Gemini AI API
GEMINI_API_KEY=your_gemini_api_key_here
